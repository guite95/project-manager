[Unit]
Description=Publish pinned Project Management Vault secrets to tmpfs
Wants=network-online.target
Requires=project-management-imds-guard.service
After=network-online.target project-management-imds-guard.service
Before=project-management-runtime.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
Environment=NODE_ENV=production
WorkingDirectory=/opt/project-management-runtime/current
ExecStart=/opt/node24/bin/node ops/oci-runtime/vault-runtime.mjs
ExecReload=/opt/node24/bin/node ops/oci-runtime/vault-runtime.mjs
UMask=0077
TimeoutStartSec=180
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/oci-service-secrets
# Creation is restricted by the root-owned fixed-path CLI, never by app input.
ReadWritePaths=/run
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
