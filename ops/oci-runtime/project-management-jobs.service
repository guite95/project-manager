[Unit]
Description=Project Management scheduled and manual job collector
Requires=docker.service project-management-runtime.service project-management-imds-guard.service project-management-secrets.service
After=docker.service project-management-runtime.service project-management-imds-guard.service project-management-secrets.service
PartOf=docker.service project-management-runtime.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /opt/project-management-runtime/current/ops/oci-runtime/imds-guard.py --check
ExecStartPre=/opt/node24/bin/node /opt/project-management-runtime/current/ops/oci-runtime/vault-readiness.mjs
ExecStartPre=/usr/bin/python3 /opt/project-management-jobs/current/jobs-worker-runtime.py prepare
ExecStart=/bin/sh -c '/usr/bin/docker start project-management-jobs >/dev/null && exec /usr/bin/docker wait project-management-jobs'
ExecStop=/usr/bin/docker stop --time 30 project-management-jobs
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target project-management-runtime.service
