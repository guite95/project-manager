[Unit]
Description=Publish Ilchul runtime secrets from OCI Vault
Wants=network-online.target
Requires=project-management-imds-guard.service
After=network-online.target project-management-imds-guard.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/opt/project-management-runtime/current
ExecStart=/opt/node24/bin/node ops/oci-runtime/vault-runtime.mjs --ilchul-backend
ExecReload=/opt/node24/bin/node ops/oci-runtime/vault-runtime.mjs --ilchul-backend
UMask=0077
TimeoutStartSec=180
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/etc/oci-service-secrets
ReadWritePaths=/run
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
