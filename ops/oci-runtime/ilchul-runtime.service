[Unit]
Description=Ilchul active-color recovery with Vault startup gate
Requires=docker.service project-management-imds-guard.service
Wants=ilchul-secrets.service redis-admin-secrets.service
After=docker.service ilchul-secrets.service redis-admin-secrets.service project-management-imds-guard.service
PartOf=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/project-management-runtime/current/ops/oci-runtime/ilchul-runtime.py
Restart=on-failure
RestartSec=10
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target docker.service
