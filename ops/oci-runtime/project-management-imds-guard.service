[Unit]
Description=Block forwarded OCI metadata HTTP without blocking host identity
Before=docker.service project-management-runtime.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/project-management-runtime/current/ops/oci-runtime/imds-guard.py --apply
ExecStartPost=/usr/bin/python3 /opt/project-management-runtime/current/ops/oci-runtime/imds-guard.py --check
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

[Install]
WantedBy=multi-user.target
