[Unit]
Description=Publish YouTube %i runtime secrets from OCI Vault
Wants=network-online.target
Requires=project-management-imds-guard.service
After=network-online.target project-management-imds-guard.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/opt/project-management-runtime/current
ExecStart=/opt/node24/bin/node ops/oci-runtime/vault-runtime.mjs --youtube-%i
ExecReload=/opt/node24/bin/node ops/oci-runtime/vault-runtime.mjs --youtube-%i
UMask=0077
TimeoutStartSec=180
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/oci-service-secrets
ReadWritePaths=/run
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
