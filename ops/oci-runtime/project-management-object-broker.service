[Unit]
Description=Project Management restricted OCI object broker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=pm-runtime
EnvironmentFile=/etc/project-management-object-broker.conf
Environment=NODE_ENV=production
WorkingDirectory=/opt/project-management-runtime/current
ExecStart=/opt/node24/bin/node ops/oci-runtime/host-runtime.mjs
RuntimeDirectory=project-management-broker
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/project-management-broker
LimitCORE=0
# SDK identity-refresh internals are outside our error sanitizer. Do not journal them.
StandardOutput=null
StandardError=null
TasksMax=64
MemoryMax=1G

[Install]
WantedBy=multi-user.target
