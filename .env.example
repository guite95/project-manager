# 로컬 개발용. 사용자 이름과 비밀번호는 각자 환경에 맞춘다.
DATABASE_URL="postgresql://USER@localhost:5432/project_management"
TEST_DATABASE_URL="postgresql://USER@localhost:5432/project_management_test"
# node scripts/hash-password.mjs 결과
APP_PASSWORD_HASH=""
# openssl rand -hex 32 결과
SESSION_SECRET=""
# 개발 환경에서도 로그인을 강제하려면 1. 평소에는 비워 둔다.
REQUIRE_LOGIN=""

# pnpm dev: private SSH tunnel to the shared project database. No server password here.
SHARED_DB_SSH_HOST=your-server.example.com
SHARED_DB_SSH_USER=your-user
SHARED_DB_SSH_PORT=61185
SHARED_DB_SSH_KEY=~/.ssh/your-personal-key
SHARED_DB_REMOTE_PORT=15432
SHARED_DB_LOCAL_PORT=15435
