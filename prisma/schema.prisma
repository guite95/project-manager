generator client {
  provider = "prisma-client-js"
}

// 접속 URL 은 prisma.config.ts 에 있다. Prisma 7 부터 스키마에 두지 않는다.
datasource db {
  provider = "postgresql"
}

/// 화면에서 직접 추가한 프로젝트만 담는다.
/// 플로우 프로젝트는 FlowProject 테이블에서 관리한다.
model CustomProject {
  slug      String   @id
  title     String
  createdAt DateTime @map("created_at")

  @@map("custom_project")
}

/// 이슈 하나가 행 하나. 이슈 풀과 오늘 목록을 나누지 않고 placement 로 구분해
/// "한 항목은 한쪽에만 있다"는 기존 불변식을 컬럼으로 표현한다.
model Issue {
  id          String   @id
  /// __personal_issues__는 개인 이슈. 나머지 미등록 값은 미분류로 묶는다. 외래키를 걸지 않는다.
  projectSlug String   @map("project_slug")
  title       String
  createdAt   DateTime @map("created_at")
  /// "pool" | "today"
  placement   String
  /// placement 가 "today" 일 때만 값이 있다. 로컬 기준 YYYY-MM-DD.
  todayDate   String?  @map("today_date")
  done        Boolean  @default(false)
  /// 자신이 속한 목록 안에서의 순서.
  position    Int

  completions Completion[]

  @@index([placement, position])
  @@map("issue")
}

/// 완료 이력. 제목과 프로젝트를 복사해 두어 원본 이슈를 지워도 이력이 남는다.
model Completion {
  id          String   @id
  issueId     String?  @map("issue_id")
  issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  projectSlug String   @map("project_slug")
  title       String
  /// 완료한 날. 로컬 기준 YYYY-MM-DD.
  completedOn String   @map("completed_on")
  completedAt DateTime @map("completed_at")

  @@index([completedOn])
  @@map("completion")
}

model ProjectNote {
  id          String   @id
  projectSlug String   @map("project_slug")
  content     String
  /// "urgent" | "high" | "normal" | "low"
  priority    String
  position    Int
  updatedAt   DateTime @map("updated_at")

  @@index([projectSlug, position])
  @@map("project_note")
}

/// board: 화면 상태. erd:tns: ERD 전체 컬럼/관계 스냅샷.
/// erd:tns:layout:domain:* / table:*: ERD 좌표·묶음·연결점·관계선 경로와 스냅샷 해시.
model AppSetting {
  key   String @id
  value Json

  @@map("app_setting")
}

model FlowProject {
  slug       String @id
  title      String
  intro      String?
  position   Int
  categories FlowCategory[]
  memberships AccessMembership[]
  recordings ProjectRecording[]

  @@map("flow_project")
}

model FlowCategory {
  projectSlug String @map("project_slug")
  slug        String
  title       String
  position    Int
  project     FlowProject @relation(fields: [projectSlug], references: [slug], onDelete: Restrict)
  charts      FlowDocument[]

  @@id([projectSlug, slug])
  @@map("flow_category")
}

model FlowDocument {
  projectSlug  String @map("project_slug")
  slug         String
  categorySlug String @map("category_slug")
  position     Int
  document     Json
  revision     Int @default(1)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  category     FlowCategory @relation(fields: [projectSlug, categorySlug], references: [projectSlug, slug], onDelete: Restrict)

  shares AccessShare[]

  @@id([projectSlug, slug])
  @@index([projectSlug, categorySlug, position])
  @@map("flow_document")
}

model AiOpsDevice {
  id String @id
  name String
  lastSyncAt DateTime @default(now()) @map("last_sync_at") @db.Timestamptz(6)
  rootCount Int @default(0) @map("root_count")
  files Int @default(0)
  errors Int @default(0)
  sessions AiOpsSession[]
  @@map("ai_ops_device")
}
model AiOpsSession {
  id String @id
  deviceId String @map("device_id")
  device AiOpsDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source String
  externalId String @map("external_id")
  cwd String
  title String
  startedAt DateTime @map("started_at") @db.Timestamptz(6)
  lastActiveAt DateTime @map("last_active_at") @db.Timestamptz(6)
  messages AiOpsMessage[]
  usage AiOpsUsage[]
  searchRevision BigInt @default(0) @map("search_revision")
  searchState AiOpsSearchState?
  searchDocuments AiOpsSearchDocument[]
  @@unique([deviceId, source, externalId])
  @@index([lastActiveAt(sort: Desc), id], map: "ai_ops_session_active_idx")
  @@map("ai_ops_session")
}
model AiOpsMessage {
  id String @id
  sessionId String @map("session_id")
  session AiOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role String
  model String?
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  body String?
  sourceMetadata Json @default("{}") @map("source_metadata")
  chars Int
  searchDocuments AiOpsSearchDocument[]
  @@unique([id, sessionId], map: "ai_ops_message_id_session_key")
  @@index([sessionId, occurredAt, id], map: "ai_ops_message_session_time_idx")
  @@index([occurredAt], map: "ai_ops_message_time_idx")
  @@map("ai_ops_message")
}
model AiOpsUsage {
  id String @id
  sessionId String @map("session_id")
  session AiOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  model String?
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  inputTokens BigInt? @map("input_tokens")
  cacheReadTokens BigInt? @map("cache_read_tokens")
  cacheWriteTokens BigInt? @map("cache_write_tokens")
  outputTokens BigInt? @map("output_tokens")
  reasoningTokens BigInt? @map("reasoning_tokens")
  totalTokens BigInt? @map("total_tokens")
  @@index([sessionId, occurredAt, id], map: "ai_ops_usage_session_time_idx")
  @@index([occurredAt], map: "ai_ops_usage_time_idx")
  @@map("ai_ops_usage")
}

// FTS expression indexes, generated columns, CHECKs and revision triggers are owned by SQL migrations.
// The optional pgvector table/index is SQL-owned: scripts/sql/ai-ops-vector.sql.
model AiOpsSearchState {
  sessionId String @id @map("session_id")
  session AiOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  indexedRevision BigInt @map("indexed_revision")
  chunkVersion String @map("chunk_version")
  indexedAt DateTime @default(now()) @map("indexed_at") @db.Timestamptz(6)
  @@map("ai_ops_search_state")
}
model AiOpsSearchDocument {
  id String @id
  sessionId String @map("session_id")
  session AiOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId String? @map("message_id")
  message AiOpsMessage? @relation(fields: [messageId, sessionId], references: [id, sessionId], onDelete: Cascade)
  kind String
  chunkIndex Int @map("chunk_index")
  chunkVersion String @map("chunk_version")
  sourceRevision BigInt @map("source_revision")
  title String
  content String
  contentHash String @map("content_hash")
  chars Int
  contentType String @map("content_type")
  searchable Boolean
  embeddingEnabled Boolean @map("embedding_enabled")
  importance Float @db.Real
  metadata Json @default("{}")
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, content)")) @map("search_vector")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  embeddings AiOpsDocumentEmbedding[]
  @@unique([id, contentHash])
  @@index([sessionId, kind], map: "ai_ops_search_document_session_idx")
  @@index([searchVector], type: Gin, map: "ai_ops_search_document_fts_idx")
  @@map("ai_ops_search_document")
}
model AiOpsEmbeddingProfile {
  id String @id
  provider String
  model String
  dimensions Int
  version String
  inputVersion String @map("input_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  jobs AiOpsEmbeddingJob[]
  @@unique([provider, model, dimensions, version, inputVersion])
  @@unique([id, dimensions])
  @@map("ai_ops_embedding_profile")
}
model AiOpsEmbeddingJob {
  profileId String @map("profile_id")
  profile AiOpsEmbeddingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contentHash String @map("content_hash")
  title String
  content String
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  errorCode String? @map("error_code")
  embeddedAt DateTime? @map("embedded_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  documents AiOpsDocumentEmbedding[]
  @@id([profileId, contentHash])
  @@index([profileId, status, availableAt], map: "ai_ops_embedding_job_pending_idx")
  @@map("ai_ops_embedding_job")
}
model AiOpsDocumentEmbedding {
  documentId String @map("document_id")
  profileId String @map("profile_id")
  contentHash String @map("content_hash")
  document AiOpsSearchDocument @relation(fields: [documentId, contentHash], references: [id, contentHash], onDelete: Cascade, onUpdate: NoAction)
  job AiOpsEmbeddingJob @relation(fields: [profileId, contentHash], references: [profileId, contentHash], onDelete: Cascade, onUpdate: NoAction)
  @@id([documentId, profileId])
  @@index([profileId, contentHash], map: "ai_ops_document_embedding_cache_idx")
  @@map("ai_ops_document_embedding")
}

/// OWNER는 최초 등록된 개인 데이터 소유자다. 역할 값은 SQL CHECK로 제한한다.
model AccessUser {
  id String @id
  username String @unique
  name String
  passwordHash String @map("password_hash")
  role String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  sessions AccessSession[]
  memberships AccessMembership[]
  @@map("access_user")
}
model AccessSession {
  tokenHash String @id @map("token_hash")
  userId String @map("user_id")
  user AccessUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  @@index([userId])
  @@map("access_session")
}
model AccessMembership {
  userId String @map("user_id")
  projectSlug String @map("project_slug")
  role String
  user AccessUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  project FlowProject @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  @@id([userId, projectSlug])
  @@map("access_membership")
}
model AccessInvite {
  id String @id
  tokenHash String @unique @map("token_hash")
  username String @unique
  name String
  role String
  expiresAt DateTime @map("expires_at")
  @@map("access_invite")
}
model AccessShare {
  id String @id
  tokenHash String @unique @map("token_hash")
  projectSlug String @map("project_slug")
  chartSlug String @map("chart_slug")
  expiresAt DateTime @map("expires_at")
  document FlowDocument @relation(fields: [projectSlug, chartSlug], references: [projectSlug, slug], onDelete: Cascade)
  @@map("access_share")
}
model AccessAudit {
  id String @id
  actorId String @map("actor_id")
  action String
  target String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("access_audit")
}
model AccessThrottle {
  key String @id
  attempts Int
  expiresAt DateTime @map("expires_at")
  @@map("access_throttle")
}

/// 원본과 전사 결과는 별도 레코드다. 대기열은 lease token으로 중복 완료를 막는다.
model ProjectRecording {
  id String @id
  projectSlug String @map("project_slug")
  project FlowProject @relation(fields: [projectSlug], references: [slug], onDelete: Restrict)
  title String
  kind String
  context String @default("")
  fileName String @map("file_name")
  contentType String @map("content_type")
  byteLength Int @map("byte_length")
  storage Json
  status String @default("PENDING")
  attempts Int @default(0)
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  error String?
  operation String?
  staging Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  transcript RecordingTranscript?
  @@index([projectSlug, createdAt])
  @@index([status, createdAt])
  @@map("project_recording")
}
model RecordingTranscript {
  recordingId String @id @map("recording_id")
  recording ProjectRecording @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  text String
  language String
  engine String
  model String
  result Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("recording_transcript")
}
