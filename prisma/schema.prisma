generator client {
  provider = "prisma-client-js"
}

// 접속 URL 은 prisma.config.ts 에 있다. Prisma 7 부터 스키마에 두지 않는다.
datasource db {
  provider = "postgresql"
}

/// 화면에서 직접 추가한 프로젝트만 담는다.
/// 플로우 프로젝트는 FlowProject 테이블에서 관리한다.
model CustomProject {
  slug      String   @id
  title     String
  createdAt DateTime @map("created_at")

  @@map("custom_project")
}

/// 이슈 하나가 행 하나. 이슈 풀과 오늘 목록을 나누지 않고 placement 로 구분해
/// "한 항목은 한쪽에만 있다"는 기존 불변식을 컬럼으로 표현한다.
model Issue {
  id          String   @id
  /// __personal_issues__는 개인 이슈. 나머지 미등록 값은 미분류로 묶는다. 외래키를 걸지 않는다.
  projectSlug String   @map("project_slug")
  title       String
  createdAt   DateTime @map("created_at")
  /// "pool" | "today"
  placement   String
  /// placement 가 "today" 일 때만 값이 있다. 로컬 기준 YYYY-MM-DD.
  todayDate   String?  @map("today_date")
  done        Boolean  @default(false)
  /// 자신이 속한 목록 안에서의 순서.
  position    Int

  completions Completion[]

  @@index([placement, position])
  @@map("issue")
}

/// 완료 이력. 제목과 프로젝트를 복사해 두어 원본 이슈를 지워도 이력이 남는다.
model Completion {
  id          String   @id
  issueId     String?  @map("issue_id")
  issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  projectSlug String   @map("project_slug")
  title       String
  /// 완료한 날. 로컬 기준 YYYY-MM-DD.
  completedOn String   @map("completed_on")
  completedAt DateTime @map("completed_at")

  @@index([completedOn])
  @@map("completion")
}

model ProjectNote {
  id          String   @id
  projectSlug String   @map("project_slug")
  content     String
  /// "urgent" | "high" | "normal" | "low"
  priority    String
  position    Int
  updatedAt   DateTime @map("updated_at")

  @@index([projectSlug, position])
  @@map("project_note")
}

/// board: 화면 상태. erd:tns: ERD 전체 컬럼/관계 스냅샷.
/// erd:tns:layout:domain:* / table:*: ERD 좌표·묶음·연결점·관계선 경로와 스냅샷 해시.
model AppSetting {
  key   String @id
  value Json

  @@map("app_setting")
}

model ProjectRepository {
  workspace   String
  path        String
  projectSlug String @map("project_slug")
  project     FlowProject @relation(fields: [projectSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)

  @@id([workspace, path])
  @@index([projectSlug])
  @@map("project_repository")
}

model FlowProject {
  showInTasks   Boolean @default(true) @map("show_in_tasks")
  scope         String @default("COMPANY")
  personalGroup String? @map("personal_group")
  revision      Int @default(0)
  repositories  ProjectRepository[]
  slug       String @id
  title      String
  intro      String?
  position   Int
  categories FlowCategory[]
  memberships AccessMembership[]
  recordings ProjectRecording[]

  @@map("flow_project")
}

model FlowCategory {
  projectSlug String @map("project_slug")
  slug        String
  title       String
  position    Int
  project     FlowProject @relation(fields: [projectSlug], references: [slug], onDelete: Restrict)
  charts      FlowDocument[]

  @@id([projectSlug, slug])
  @@map("flow_category")
}

model FlowDocument {
  projectSlug  String @map("project_slug")
  slug         String
  categorySlug String @map("category_slug")
  position     Int
  document     Json
  revision     Int @default(1)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  category     FlowCategory @relation(fields: [projectSlug, categorySlug], references: [projectSlug, slug], onDelete: Restrict)

  shares AccessShare[]

  @@id([projectSlug, slug])
  @@index([projectSlug, categorySlug, position])
  @@map("flow_document")
}

model AiOpsDevice {
  id String @id
  name String
  lastSyncAt DateTime @default(now()) @map("last_sync_at") @db.Timestamptz(6)
  rootCount Int @default(0) @map("root_count")
  files Int @default(0)
  errors Int @default(0)
  sessions AiOpsSession[]
  @@map("ai_ops_device")
}
model AiOpsSession {
  id String @id
  deviceId String @map("device_id")
  device AiOpsDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source String
  externalId String @map("external_id")
  cwd String
  title String
  startedAt DateTime @map("started_at") @db.Timestamptz(6)
  lastActiveAt DateTime @map("last_active_at") @db.Timestamptz(6)
  messages AiOpsMessage[]
  usage AiOpsUsage[]
  searchRevision BigInt @default(0) @map("search_revision")
  searchState AiOpsSearchState?
  searchDocuments AiOpsSearchDocument[]
  @@unique([deviceId, source, externalId])
  @@index([lastActiveAt(sort: Desc), id], map: "ai_ops_session_active_idx")
  @@map("ai_ops_session")
}
model AiOpsMessage {
  id String @id
  sessionId String @map("session_id")
  session AiOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role String
  model String?
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  body String?
  sourceMetadata Json @default("{}") @map("source_metadata")
  chars Int
  searchDocuments AiOpsSearchDocument[]
  @@unique([id, sessionId], map: "ai_ops_message_id_session_key")
  @@index([sessionId, occurredAt, id], map: "ai_ops_message_session_time_idx")
  @@index([occurredAt], map: "ai_ops_message_time_idx")
  @@map("ai_ops_message")
}
model AiOpsUsage {
  id String @id
  sessionId String @map("session_id")
  session AiOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  model String?
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  inputTokens BigInt? @map("input_tokens")
  cacheReadTokens BigInt? @map("cache_read_tokens")
  cacheWriteTokens BigInt? @map("cache_write_tokens")
  outputTokens BigInt? @map("output_tokens")
  reasoningTokens BigInt? @map("reasoning_tokens")
  totalTokens BigInt? @map("total_tokens")
  @@index([sessionId, occurredAt, id], map: "ai_ops_usage_session_time_idx")
  @@index([occurredAt], map: "ai_ops_usage_time_idx")
  @@map("ai_ops_usage")
}

// FTS expression indexes, generated columns, CHECKs and revision triggers are owned by SQL migrations.
// The optional pgvector table/index is SQL-owned: scripts/sql/ai-ops-vector.sql.
model AiOpsSearchState {
  sessionId String @id @map("session_id")
  session AiOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  indexedRevision BigInt @map("indexed_revision")
  chunkVersion String @map("chunk_version")
  indexedAt DateTime @default(now()) @map("indexed_at") @db.Timestamptz(6)
  @@map("ai_ops_search_state")
}
model AiOpsSearchDocument {
  id String @id
  sessionId String @map("session_id")
  session AiOpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId String? @map("message_id")
  message AiOpsMessage? @relation(fields: [messageId, sessionId], references: [id, sessionId], onDelete: Cascade)
  kind String
  chunkIndex Int @map("chunk_index")
  chunkVersion String @map("chunk_version")
  sourceRevision BigInt @map("source_revision")
  title String
  content String
  contentHash String @map("content_hash")
  chars Int
  contentType String @map("content_type")
  searchable Boolean
  embeddingEnabled Boolean @map("embedding_enabled")
  importance Float @db.Real
  metadata Json @default("{}")
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, content)")) @map("search_vector")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  embeddings AiOpsDocumentEmbedding[]
  @@unique([id, contentHash])
  @@index([sessionId, kind], map: "ai_ops_search_document_session_idx")
  @@index([searchVector], type: Gin, map: "ai_ops_search_document_fts_idx")
  @@map("ai_ops_search_document")
}
model AiOpsEmbeddingProfile {
  id String @id
  provider String
  model String
  dimensions Int
  version String
  inputVersion String @map("input_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  jobs AiOpsEmbeddingJob[]
  @@unique([provider, model, dimensions, version, inputVersion])
  @@unique([id, dimensions])
  @@map("ai_ops_embedding_profile")
}
model AiOpsEmbeddingJob {
  profileId String @map("profile_id")
  profile AiOpsEmbeddingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contentHash String @map("content_hash")
  title String
  content String
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  errorCode String? @map("error_code")
  embeddedAt DateTime? @map("embedded_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  documents AiOpsDocumentEmbedding[]
  @@id([profileId, contentHash])
  @@index([profileId, status, availableAt], map: "ai_ops_embedding_job_pending_idx")
  @@map("ai_ops_embedding_job")
}
model AiOpsDocumentEmbedding {
  documentId String @map("document_id")
  profileId String @map("profile_id")
  contentHash String @map("content_hash")
  document AiOpsSearchDocument @relation(fields: [documentId, contentHash], references: [id, contentHash], onDelete: Cascade, onUpdate: NoAction)
  job AiOpsEmbeddingJob @relation(fields: [profileId, contentHash], references: [profileId, contentHash], onDelete: Cascade, onUpdate: NoAction)
  @@id([documentId, profileId])
  @@index([profileId, contentHash], map: "ai_ops_document_embedding_cache_idx")
  @@map("ai_ops_document_embedding")
}

/// OWNER는 최초 등록된 개인 데이터 소유자다. 역할 값은 SQL CHECK로 제한한다.
model AccessUser {
  oauthEpoch Int @default(0) @map("oauth_epoch")
  oauthUser CareerOAuthUser?
  id String @id
  username String @unique
  name String
  passwordHash String @map("password_hash")
  role String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  sessions AccessSession[]
  memberships AccessMembership[]
  @@map("access_user")
}

model CareerOAuthUser {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  session_userIdRows CareerOAuthSession[] @relation("session_userId")
  account_userIdRows CareerOAuthAccount[] @relation("account_userId")
  oauthClient_userIdRows CareerOAuthClient[] @relation("oauthClient_userId")
  oauthRefreshToken_userIdRows CareerOAuthRefreshToken[] @relation("oauthRefreshToken_userId")
  oauthAccessToken_userIdRows CareerOAuthAccessToken[] @relation("oauthAccessToken_userId")
  oauthConsent_userIdRows CareerOAuthConsent[] @relation("oauthConsent_userId")
  owner AccessUser @relation(fields: [id], references: [id], onDelete: Cascade, map: "career_oauth_user_owner_fkey")
  @@map("career_oauth_user")
}

model CareerOAuthSession {
  id String @id
  expiresAt DateTime @map("expires_at")
  token String @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  userId String @map("user_id")
  ownerEpoch Int @map("owner_epoch")
  userIdRelation CareerOAuthUser @relation("session_userId", fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshToken_sessionIdRows CareerOAuthRefreshToken[] @relation("oauthRefreshToken_sessionId")
  oauthAccessToken_sessionIdRows CareerOAuthAccessToken[] @relation("oauthAccessToken_sessionId")
  @@index([userId])
  @@map("career_oauth_session")
}

model CareerOAuthAccount {
  id String @id
  accountId String @map("account_id")
  providerId String @map("provider_id")
  userId String @map("user_id")
  accessToken String? @map("access_token")
  refreshToken String? @map("refresh_token")
  idToken String? @map("id_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope String?
  password String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  userIdRelation CareerOAuthUser @relation("account_userId", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("career_oauth_account")
}

model CareerOAuthVerification {
  id String @id
  identifier String
  value String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([identifier])
  @@map("career_oauth_verification")
}

model CareerOAuthJwks {
  id String @id
  publicKey String @map("public_key")
  privateKey String @map("private_key")
  createdAt DateTime @map("created_at")
  expiresAt DateTime? @map("expires_at")
  alg String?
  crv String?
  @@map("career_oauth_jwks")
}

model CareerOAuthClient {
  id String @id
  clientId String @unique @map("client_id")
  clientSecret String? @map("client_secret")
  clientDiscoveryId String? @map("client_discovery_id")
  disabled Boolean? @default(false)
  skipConsent Boolean? @map("skip_consent")
  enableEndSession Boolean? @map("enable_end_session")
  subjectType String? @map("subject_type")
  scopes String[] @default([])
  clientCredentialsScopes String[] @default([]) @map("client_credentials_scopes")
  userId String? @map("user_id")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  name String?
  uri String?
  icon String?
  contacts String[] @default([])
  tos String?
  policy String?
  softwareId String? @map("software_id")
  softwareVersion String? @map("software_version")
  softwareStatement String? @map("software_statement")
  redirectUris String[] @default([]) @map("redirect_uris")
  postLogoutRedirectUris String[] @default([]) @map("post_logout_redirect_uris")
  backchannelLogoutUri String? @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean? @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod String? @map("token_endpoint_auth_method")
  applicationType String? @map("application_type")
  jwks String?
  jwksUri String? @map("jwks_uri")
  grantTypes String[] @default([]) @map("grant_types")
  responseTypes String[] @default([]) @map("response_types")
  requirePKCE Boolean? @map("require_p_k_c_e")
  dpopBoundAccessTokens Boolean? @default(false) @map("dpop_bound_access_tokens")
  referenceId String? @map("reference_id")
  metadata Json?
  userIdRelation CareerOAuthUser? @relation("oauthClient_userId", fields: [userId], references: [id], onDelete: Cascade)
  oauthClientResource_clientIdRows CareerOAuthClientResource[] @relation("oauthClientResource_clientId")
  oauthRefreshToken_clientIdRows CareerOAuthRefreshToken[] @relation("oauthRefreshToken_clientId")
  oauthAccessToken_clientIdRows CareerOAuthAccessToken[] @relation("oauthAccessToken_clientId")
  oauthConsent_clientIdRows CareerOAuthConsent[] @relation("oauthConsent_clientId")
  @@index([userId])
  @@map("career_oauth_client")
}

model CareerOAuthResource {
  id String @id
  identifier String @unique
  name String
  accessTokenTtl Int? @map("access_token_ttl")
  refreshTokenTtl Int? @map("refresh_token_ttl")
  signingAlgorithm String? @map("signing_algorithm")
  signingKeyId String? @map("signing_key_id")
  allowedScopes String[] @default([]) @map("allowed_scopes")
  customClaims Json? @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean? @default(false) @map("dpop_bound_access_tokens_required")
  disabled Boolean? @default(false)
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  policyVersion Int? @default(1) @map("policy_version")
  metadata Json?
  oauthClientResource_resourceIdRows CareerOAuthClientResource[] @relation("oauthClientResource_resourceId")
  @@map("career_oauth_resource")
}

model CareerOAuthClientResource {
  id String @id
  clientId String @map("client_id")
  resourceId String @map("resource_id")
  metadata Json?
  createdAt DateTime? @map("created_at")
  clientIdRelation CareerOAuthClient @relation("oauthClientResource_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceIdRelation CareerOAuthResource @relation("oauthClientResource_resourceId", fields: [resourceId], references: [identifier], onDelete: Cascade)
  @@index([clientId])
  @@index([resourceId])
  @@unique([clientId, resourceId])
  @@map("career_oauth_client_resource")
}

model CareerOAuthRefreshToken {
  id String @id
  token String @unique
  clientId String @map("client_id")
  sessionId String? @map("session_id")
  userId String @map("user_id")
  referenceId String? @map("reference_id")
  authorizationCodeId String? @map("authorization_code_id")
  resources String[] @default([])
  requestedUserInfoClaims String[] @default([]) @map("requested_user_info_claims")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")
  revoked DateTime?
  rotatedAt DateTime? @map("rotated_at")
  rotationReplayResponse String? @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime? @map("rotation_replay_expires_at")
  authTime DateTime? @map("auth_time")
  confirmation Json?
  scopes String[] @default([])
  clientIdRelation CareerOAuthClient @relation("oauthRefreshToken_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionIdRelation CareerOAuthSession? @relation("oauthRefreshToken_sessionId", fields: [sessionId], references: [id], onDelete: SetNull)
  userIdRelation CareerOAuthUser @relation("oauthRefreshToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  oauthAccessToken_refreshIdRows CareerOAuthAccessToken[] @relation("oauthAccessToken_refreshId")
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("career_oauth_refresh_token")
}

model CareerOAuthAccessToken {
  id String @id
  token String @unique
  clientId String @map("client_id")
  sessionId String? @map("session_id")
  userId String? @map("user_id")
  referenceId String? @map("reference_id")
  authorizationCodeId String? @map("authorization_code_id")
  resources String[] @default([])
  requestedUserInfoClaims String[] @default([]) @map("requested_user_info_claims")
  refreshId String? @map("refresh_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")
  revoked DateTime?
  confirmation Json?
  scopes String[] @default([])
  clientIdRelation CareerOAuthClient @relation("oauthAccessToken_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionIdRelation CareerOAuthSession? @relation("oauthAccessToken_sessionId", fields: [sessionId], references: [id], onDelete: SetNull)
  userIdRelation CareerOAuthUser? @relation("oauthAccessToken_userId", fields: [userId], references: [id], onDelete: Cascade)
  refreshIdRelation CareerOAuthRefreshToken? @relation("oauthAccessToken_refreshId", fields: [refreshId], references: [id], onDelete: Cascade)
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("career_oauth_access_token")
}

model CareerOAuthConsent {
  id String @id
  clientId String @map("client_id")
  userId String? @map("user_id")
  referenceId String? @map("reference_id")
  resources String[] @default([])
  requestedUserInfoClaims String[] @default([]) @map("requested_user_info_claims")
  scopes String[] @default([])
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  clientIdRelation CareerOAuthClient @relation("oauthConsent_clientId", fields: [clientId], references: [clientId], onDelete: Cascade)
  userIdRelation CareerOAuthUser? @relation("oauthConsent_userId", fields: [userId], references: [id], onDelete: Cascade)
  @@index([clientId])
  @@index([userId])
  @@map("career_oauth_consent")
}

model CareerOAuthClientAssertion {
  id String @id
  expiresAt DateTime @map("expires_at")
  @@map("career_oauth_client_assertion")
}

model CareerOAuthRequest {
  id String @id
  query String
  stage String
  consentHash String? @map("consent_hash")
  ownerEpoch Int? @map("owner_epoch")
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("career_oauth_request")
}

model AccessSession {
  tokenHash String @id @map("token_hash")
  userId String @map("user_id")
  user AccessUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  @@index([userId])
  @@map("access_session")
}
model AccessMembership {
  userId String @map("user_id")
  projectSlug String @map("project_slug")
  role String
  user AccessUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  project FlowProject @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  @@id([userId, projectSlug])
  @@map("access_membership")
}
model AccessInvite {
  id String @id
  tokenHash String @unique @map("token_hash")
  username String @unique
  name String
  role String
  expiresAt DateTime @map("expires_at")
  @@map("access_invite")
}
model AccessShare {
  id String @id
  tokenHash String @unique @map("token_hash")
  projectSlug String @map("project_slug")
  chartSlug String @map("chart_slug")
  expiresAt DateTime @map("expires_at")
  document FlowDocument @relation(fields: [projectSlug, chartSlug], references: [projectSlug, slug], onDelete: Cascade)
  @@map("access_share")
}
model AccessAudit {
  id String @id
  actorId String @map("actor_id")
  action String
  target String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("access_audit")
}
model AccessThrottle {
  key String @id
  attempts Int
  expiresAt DateTime @map("expires_at")
  @@map("access_throttle")
}

/// 원본과 전사 결과는 별도 레코드다. 대기열은 lease token으로 중복 완료를 막는다.
model ProjectRecording {
  id String @id
  projectSlug String @map("project_slug")
  project FlowProject @relation(fields: [projectSlug], references: [slug], onDelete: Restrict)
  title String
  kind String
  context String @default("")
  fileName String @map("file_name")
  contentType String @map("content_type")
  byteLength Int @map("byte_length")
  storage Json
  status String @default("PENDING")
  attempts Int @default(0)
  leaseToken String? @map("lease_token")
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  error String?
  operation String?
  staging Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  transcript RecordingTranscript?
  @@index([projectSlug, createdAt])
  @@index([status, createdAt])
  @@map("project_recording")
}
model RecordingTranscript {
