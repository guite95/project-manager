{
  "name": "project-management",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/with-shared-db.mjs -- pnpm exec next dev --hostname 127.0.0.1 -p 30001",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"lib/**/*.test.mjs\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:reset-test": "node --env-file=.env scripts/reset-test-db.mjs",
    "dev:local": "next dev -p 30001",
    "db:shared": "node --experimental-strip-types scripts/with-shared-db.mjs",
    "db:shared:status": "node --experimental-strip-types scripts/with-shared-db.mjs -- pnpm exec prisma migrate status",
    "db:shared:deploy": "node --experimental-strip-types scripts/with-shared-db.mjs -- pnpm exec prisma migrate deploy",
    "flow": "node --experimental-strip-types scripts/pm-flow.mjs",
    "flow:install": "node scripts/install-flow-tools.mjs",
    "ai:agent": "node scripts/ai-ops-agent.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/mdx": "^2.0.13",
    "@xyflow/react": "^12.11.0",
    "html-to-image": "^1.11.13",
    "next": "16.3.5",
    "oci-common": "^2.141.0",
    "oci-objectstorage": "^2.141.0",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
